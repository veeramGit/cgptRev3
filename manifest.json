{
  "manifest_version": 3,
  "name": "Multi-Interval Trading Timer",
  "version": "1.0.0",
  "version_name": "NSE Time V2",
  "description": "Multi-interval candle timers with desktop notifications and an alert beep.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "action": {
    "default_title": "Multi-Interval Trading Timer",
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
