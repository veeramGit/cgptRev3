{
  "manifest_version": 3,
  "name": "Multi-Interval Trading Timer",
  "version": "1.4.1",
  "version_name": "NSE Timer v1.4",
  "description": "Multi-market trading timer for NSE, global indices, Gold, and crypto with candle timout alerts and desktop notifications.",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://extensionpay.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["ExtPay.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Multi-Interval Trading Timer",
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
